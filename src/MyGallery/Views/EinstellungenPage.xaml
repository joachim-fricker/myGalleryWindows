<Page x:Class="MyGallery.Views.EinstellungenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Einstellungen"
      ScrollViewer.CanContentScroll="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="700" HorizontalAlignment="Left">
            <ui:TextBlock Text="Einstellungen" FontTypography="Title" />

            <ui:Card Margin="0,16,0,0">
                <StackPanel>
                    <ui:TextBlock Text="Bildordner" FontTypography="Subtitle" />
                    <ui:TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                  Text="Alle Bilder in diesem Ordner und seinen Unterordnern (entspricht Data/images auf dem Handy)." />
                    <DockPanel Margin="0,12,0,0">
                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Ändern …"
                                   Icon="{ui:SymbolIcon FolderOpen24}" Click="OnChooseFolder" />
                        <ui:TextBox x:Name="FolderBox" IsReadOnly="True" />
                    </DockPanel>
                    <ui:TextBlock x:Name="CountText" Margin="0,12,0,0" />
                    <ui:Button Margin="0,12,0,0" Content="Neu einlesen" Appearance="Primary"
                               Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRescan" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <ui:TextBlock Text="Vom Handy importieren" FontTypography="Subtitle" />
                    <ui:TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                  Text="Übernimmt Favoriten, Personen, Gruppen und alle erkannten Gesichter aus der Android-App (dort Menü ⋮ → „Export für Windows“, die ZIP-Datei auf den PC kopieren). Personen und Gesichter unter Windows werden dabei ersetzt, Favoriten ergänzt." />
                    <ui:Button x:Name="ImportButton" Margin="0,12,0,0" Content="ZIP-Datei wählen und importieren …"
                               Icon="{ui:SymbolIcon ArrowImport24}" Click="OnImport" />
                    <ProgressBar x:Name="ImportProgress" Margin="0,12,0,0" Height="4" IsIndeterminate="True"
                                 Visibility="Collapsed" />
                    <ui:TextBlock x:Name="ImportText" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <ui:TextBlock Text="Sortierung" FontTypography="Subtitle" />
                    <ui:ToggleSwitch x:Name="OldestFirstSwitch" Margin="0,8,0,0" Content="Älteste zuerst"
                                     Checked="OnSortChanged" Unchecked="OnSortChanged" />
                    <ui:TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                  Text="Gilt für alle Bilder, Alben und das Menü. Auch umschaltbar mit dem Sortier-Knopf oben rechts." />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <ui:TextBlock Text="Vorschaubilder" FontTypography="Subtitle" />
                    <ui:TextBlock x:Name="ThumbText" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <ui:Button Margin="0,12,0,0" Content="Vorschaubilder löschen"
                               Icon="{ui:SymbolIcon Delete24}" Click="OnClearThumbs" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <ui:TextBlock Text="Speicherorte" FontTypography="Subtitle" />
                    <ui:TextBlock x:Name="DataText" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <ui:TextBlock x:Name="DbText" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
