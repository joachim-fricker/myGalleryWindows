<Page x:Class="MyGallery.Views.AlbenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:MyGallery.Views"
      Title="Alben"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="16,8,8,0">

        <!-- Übersicht: Favoriten, dann pro Jahr (aufklappbar) alle Alben -->
        <Grid x:Name="OverviewPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,8,4">
                <ui:Button x:Name="SortButton" DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowSort24}"
                           Click="OnToggleSort" />
                <ui:TextBlock x:Name="TitleText" Text="Alben" FontTypography="Subtitle" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl x:Name="Rows"
                          Grid.Row="1"
                          Focusable="False"
                          PreviewMouseLeftButtonUp="OnRowsClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="PART_Scroller"
                                      CanContentScroll="True"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Visible">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Resources>
                    <!-- Überschrift: "Favoriten" oder Jahr (Klick = auf-/zuklappen) -->
                    <DataTemplate DataType="{x:Type views:SectionRow}">
                        <Border Height="{x:Static views:AlbenPage.SectionHeight}"
                                Background="Transparent"
                                Cursor="{Binding Cursor}"
                                Margin="0,0,8,0"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <DockPanel Margin="4,14,8,6">
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Chevron}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                    <!-- Eine Zeile Album-Karten -->
                    <DataTemplate DataType="{x:Type views:AlbumCardRow}">
                        <views:AlbumRowView />
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
        </Grid>

        <!-- Detail: Bilder eines Albums oder der Favoriten -->
        <Grid x:Name="DetailPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,8,6">
                <ui:Button DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center"
                           Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="Zurück (Esc)" Click="OnBack" />
                <ui:Button x:Name="DetailSortButton" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                           Icon="{ui:SymbolIcon ArrowSort24}" Click="OnToggleSort" />
                <StackPanel x:Name="SelectionBar" DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <ui:Button x:Name="SelectAllButton" Margin="0,0,8,0" Content="Alle" Click="OnSelectAll" />
                    <ui:Button Content="Aus Favoriten entfernen" Appearance="Danger"
                               Icon="{ui:SymbolIcon Delete24}" Click="OnRemoveFavorites" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock x:Name="DetailTitle" FontTypography="Subtitle" />
                    <TextBlock x:Name="DetailSubtitle" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
            <views:ImageGrid x:Name="DetailGrid" Grid.Row="1" />
            <ui:TextBlock x:Name="DetailEmpty" Grid.Row="1" Visibility="Collapsed" TextAlignment="Center"
                          HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                          Text="Noch keine Favoriten.&#x0a;Im Vollbild auf das Herz klicken (oder Taste F)." />
        </Grid>
    </Grid>
</Page>
