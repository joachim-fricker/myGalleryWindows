<Page x:Class="MyGallery.Views.LaenderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:MyGallery.Views"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      Title="Länder"
      ScrollViewer.CanContentScroll="False">
    <Grid Margin="16,8,8,8">

        <!-- Übersicht: Weltkarte (besuchte Länder rot) + Liste -->
        <Grid x:Name="OverviewPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,8,6">
                <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="220" PlaceholderText="Land suchen …"
                            TextChanged="OnSearchChanged" />
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock x:Name="TitleText" Text="Länder" FontTypography="Subtitle" />
                    <TextBlock x:Name="SummaryText" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="420" MinWidth="260" />
                </Grid.ColumnDefinitions>
                <wv2:WebView2 x:Name="Map" Grid.Column="0" />
                <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center"
                              Background="Transparent" ResizeBehavior="PreviousAndNext" />
                <DataGrid x:Name="CountryTable" Grid.Column="2"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          CanUserSortColumns="True" CanUserResizeRows="False"
                          SelectionChanged="OnCountrySelected"
                          MouseDoubleClick="OnCountryDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="38" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding FlagUrl, TargetNullValue={x:Null}}" Width="24" Height="16"
                                           Stretch="Uniform" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Land" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Bilder" Binding="{Binding Count, StringFormat=N0}" SortMemberPath="Count" />
                        <DataGridTextColumn Header="Zeitraum" Binding="{Binding Period}" SortMemberPath="First" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Gewähltes Land -->
            <DockPanel x:Name="CountryPanel" Grid.Row="2" Margin="0,10,8,0" Visibility="Collapsed">
                <ui:Button x:Name="ShowImagesButton" DockPanel.Dock="Right" Appearance="Primary"
                           Icon="{ui:SymbolIcon ImageMultiple24}" Content="Bilder anzeigen" Click="OnShowImages" />
                <Image x:Name="CountryFlag" Width="36" Height="24" Margin="0,0,12,0" Stretch="Uniform"
                       VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock x:Name="CountryTitle" FontTypography="BodyStrong" />
                    <TextBlock x:Name="CountryInfoText" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Bilder eines Landes -->
        <Grid x:Name="DetailPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,8,6">
                <ui:Button DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Center"
                           Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="Zurück (Esc)" Click="OnBack" />
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock x:Name="DetailTitle" FontTypography="Subtitle" />
                    <TextBlock x:Name="DetailSubtitle" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
            <views:ImageGrid x:Name="DetailGrid" Grid.Row="1" />
        </Grid>
    </Grid>
</Page>
