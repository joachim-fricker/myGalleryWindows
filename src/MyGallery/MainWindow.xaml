<ui:FluentWindow x:Class="MyGallery.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:MyGallery.Views"
                 Title="myGallery"
                 Icon="app.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="myGallery" />

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="270">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Alle"
                                       Icon="{ui:SymbolIcon Image24}"
                                       TargetPageType="{x:Type views:AlleBilderPage}"
                                       NavigationCacheMode="Enabled" />
                <ui:NavigationViewItem Content="Personen"
                                       Icon="{ui:SymbolIcon People24}"
                                       TargetPageType="{x:Type views:PersonenPage}"
                                       NavigationCacheMode="Enabled" />
                <ui:NavigationViewItem Content="Länder"
                                       Icon="{ui:SymbolIcon Globe24}"
                                       TargetPageType="{x:Type views:LaenderPage}"
                                       NavigationCacheMode="Enabled" />
                <ui:NavigationViewItem Content="Karte"
                                       Icon="{ui:SymbolIcon Map24}"
                                       TargetPageType="{x:Type views:KartePage}"
                                       NavigationCacheMode="Enabled" />
                <!-- Unterpunkte (Favoriten) und die Jahre darunter werden in MainWindow.xaml.cs erzeugt -->
                <ui:NavigationViewItem x:Name="AlbenItem"
                                       Content="Alben"
                                       Icon="{ui:SymbolIcon ImageMultiple24}"
                                       TargetPageType="{x:Type views:AlbenPage}"
                                       NavigationCacheMode="Enabled" />

            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Einstellungen"
                                       Icon="{ui:SymbolIcon Settings24}"
                                       TargetPageType="{x:Type views:EinstellungenPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
